    b=pm_precise_dot3(x,y,z,make_float2(-0.4649170935153961f, -6.48460396490691e-09f),make_float2(1.2514238357543945f, -5.575439487870426e-08f),make_float2(0.1748846173286438f, -7.3286439139508275e-09f));
    c=pm_precise_dot3(x,y,z,make_float2(0.06484904885292053f, 1.1470794314405452e-09f),make_float2(0.1091393381357193f, 1.864280729790835e-09f),make_float2(0.761414647102356f, -2.710235591507626e-08f));

    float3 linear=make_float3(pm_rn_add(a.x,a.y),pm_rn_add(b.x,b.y),pm_rn_add(c.x,c.y));
    if (!pm_finite3(linear)) return original;
    float3 encoded=make_float3(pm_encode(linear.x),pm_encode(linear.y),pm_encode(linear.z));
    return pm_finite3(encoded) ? encoded : original;
}
__DEVICE__ int pm_domain(float3 lab, float c, float s) {
    return pm_finite3(lab) && pm_finite(c) && pm_finite(s) &&
        lab.x > 1.0e-6f && c > 1.0e-7f && s > 1.0e-7f;
}
__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y, float p_R, float p_G, float p_B)
{
    float3 original = make_float3(p_R, p_G, p_B);
    if (pm_bypass || pm_compression == 0.0f) return original;
    if (!pm_finite3(original)) return original;
    // Exact equal-channel neutral: avoid residual chroma from printed matrices.
    if (p_R == p_G && p_G == p_B) return original;
    float3 linear = make_float3(pm_decode(p_R), pm_decode(p_G), pm_decode(p_B));
    if (!pm_finite3(linear)) return original;
    float3 xyz = pm_dwg_xyz(linear);
    if (!pm_finite3(xyz)) return original;
    float3 lms = pm_xyz_lms(xyz);
    if (!pm_finite3(lms)) return original;
    if (pm_precision_route(lms)) return pm_precise_transform(original);
    float3 lab = pm_root_lab(make_float3(pm_cbrt(lms.x), pm_cbrt(lms.y), pm_cbrt(lms.z)));
    float c = _sqrtf(lab.y*lab.y + lab.z*lab.z);
    if (!pm_finite3(lab) || !pm_finite(c) || lab.x <= 1.0e-6f || c <= 1.0e-7f) return original;
    float s = 100.0f * (c / lab.x);
    if (!pm_domain(lab, c, s)) return original;
    float out_s = pm_transfer(s, pm_threshold, pm_compression, pm_softness);
    if (!pm_finite(out_s)) return original;
    if (out_s == s) return original;
    float scale = out_s / s;
    float3 root = pm_lab_root(make_float3(lab.x, lab.y*scale, lab.z*scale));
    if (!pm_finite3(root)) return original;
    lms = make_float3(root.x*root.x*root.x, root.y*root.y*root.y, root.z*root.z*root.z);
    if (!pm_finite3(lms)) return original;
    xyz = pm_lms_xyz(lms);
    if (!pm_finite3(xyz)) return original;
    linear = pm_xyz_dwg(xyz);
    if (!pm_finite3(linear)) return original;
    float3 out_rgb = make_float3(pm_encode(linear.x), pm_encode(linear.y), pm_encode(linear.z));
    return pm_finite3(out_rgb) ? out_rgb : original;
}
